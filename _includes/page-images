{% comment %}
  Show all images in page.images. Example: {% include page-images %}
{% endcomment %}
{% for item in page.images %}
<figure class="page-image">
  <img src="{{ site.urlimg }}{{ item.image_name }}"{% if item.image_title %} title="{{ item.image_title }}"{% endif %}{% if item.image_alt %} alt="{{ item.image_alt }}"{% endif %}>
</figure>
{% endfor %}
