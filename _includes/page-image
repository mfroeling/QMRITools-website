{% comment %}
  Show the image(s) in page.images with a matching image_id, linked to the full size.
  Example: {% include page-image im_id='flow' %}
{% endcomment %}
{% assign items = page.images | where: "image_id", include.im_id %}
{% for item in items %}
<figure class="page-image">
  <a href="{{ site.urlimg }}{{ item.image_name }}" target="_blank" rel="noopener"><img src="{{ site.urlimg }}{{ item.image_name }}"{% if item.image_title %} title="{{ item.image_title }}"{% endif %}{% if item.image_alt %} alt="{{ item.image_alt }}"{% endif %}></a>
</figure>
{% endfor %}
