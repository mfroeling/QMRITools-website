{% comment %}
  List all pages that have the given tag. Example: {% include list-pages tag='packages' %}
{% endcomment %}
<ul class="page-list">
{% for p in site.pages %}{% if p.tags contains include.tag %}
  <li><a href="{{ site.baseurl }}{{ p.url }}">{{ p.title }}</a></li>
{% endif %}{% endfor %}
</ul>
